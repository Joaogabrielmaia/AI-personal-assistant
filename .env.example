# Copie para .env e preencha. O .env NUNCA vai pro GitHub (está no .gitignore).

# Como o assistente te chama
OWNER_NAME=Fulano

# Canal: telegram (recomendado) ou whatsapp (experimental)
CANAL=telegram

# --- Telegram ---
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token
TELEGRAM_TOKEN=cole-o-token-do-botfather
# 2) Deixe vazio na 1ª vez: mande "oi" pro bot e ele responde com o seu ID. Cole aqui e reinicie.
#    Só esse ID conversa com o bot; qualquer outro é ignorado (sem gastar IA).
TELEGRAM_OWNER_ID=

# --- IA principal (qualquer API compatível com OpenAI) ---
# Exemplo Groq (rápido, plano grátis com limite de tokens/min): https://console.groq.com
LLM_API_KEY=cole-sua-chave
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_VISION_MODEL=qwen/qwen3.8-27b   # modelo que enxerga fotos (recibos, etc.)
LLM_NULLABLE=1                       # Groq precisa de "null" nos parâmetros opcionais
# Segundos que o principal tem para responder antes de passar ao reserva
# LLM_TIMEOUT_PRINCIPAL=12

# --- IA reserva (opcional, recomendado): se a principal falhar/limite/lenta, o bot troca sozinho ---
# Exemplo Gemini: https://aistudio.google.com/apikey
# LLM2_API_KEY=
# LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM2_MODEL=gemini-3.5-flash-lite
# LLM2_NULLABLE=0                    # Gemini não aceita "null" nos parâmetros

# --- Áudio (transcrição com whisper; pode ser em outro provedor que o chat) ---
# STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# --- Google Planilhas + Agenda (opcional) ---
# 1) Crie um cliente OAuth "App para computador" no Google Cloud e salve como credenciais_oauth.json
# 2) Rode uma vez:  python -m app.google_login   (cria a planilha e grava o ID abaixo)
GOOGLE_SHEET_ID=
# Avisa quando os gastos do mês passarem disso (R$)
# LIMITE_MENSAL=1500
# Avisar eventos da agenda X minutos antes (padrão: na hora)
# EVENTO_AVISO_MIN_ANTES=10

# --- Alarme no celular (app ntfy, grátis). O nome do tópico funciona como senha: use um nome longo ---
# NTFY_TOPIC=assistente-seunome-abc123xyz

# --- WhatsApp (experimental; só se CANAL=whatsapp; precisa do docker-compose.whatsapp.yml) ---
# EVOLUTION_API_KEY=troque-por-uma-senha-longa
# EVOLUTION_URL=http://localhost:8080
# EVOLUTION_INSTANCE=bot
# OWNER_NUMBER=5511999999999
