{
  // Versão serverless do AI Personal Assistant: webhook do Telegram + relógio de 1 minuto + banco D1.
  "name": "ai-personal-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assistente",
      "database_id": "1c5a5aca-a9aa-4907-b064-134ba3c43491",
      "migrations_dir": "migrations"
    }
  ],
  // sem logs de conteúdo: mensagens suas não devem aparecer em painéis de observabilidade
  "observability": { "enabled": false }
}
