{
  // Versão serverless do AI Personal Assistant: webhook do Telegram + relógio de 1 minuto + banco D1.
  "name": "ai-personal-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assistente",
      // preencha depois de: npx wrangler d1 create assistente
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // sem logs de conteúdo: mensagens suas não devem aparecer em painéis de observabilidade
  "observability": { "enabled": false }
}
